rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMaster() {
      return signedIn()
        && request.auth.token.email == 'guilhermeg.dev@gmail.com';
    }

    function usuarioPath() {
      return /databases/$(database)/documents/usuarios/$(request.auth.uid);
    }

    function isActiveOperator() {
      return signedIn()
        && exists(usuarioPath())
        && get(usuarioPath()).data.ativo == true
        && get(usuarioPath()).data.perfil in ['ADMIN', 'ATENDENTE'];
    }

    function canUseSystem() {
      return isMaster() || isActiveOperator();
    }

    function isAdmin() {
      return isMaster()
        || (
          isActiveOperator()
          && get(usuarioPath()).data.perfil == 'ADMIN'
        );
    }

    match /usuarios/{uid} {
      allow get: if isMaster() || (signedIn() && request.auth.uid == uid);
      allow list: if canUseSystem();
      allow create, update, delete: if isAdmin();
    }

    // Precisa ser lida imediatamente após o login.
    match /licencas/{documentId} {
      allow get, list: if signedIn();
      allow create, update, delete: if isMaster();
    }

    // A licença é validada pelo aplicativo, mas não participa das transações.
    match /configuracoes/{documentId} {
      allow read: if canUseSystem();
      allow create, update: if canUseSystem();
      allow delete: if isAdmin();
    }

    match /clientes/{documentId} {
      allow read: if canUseSystem();
      allow create, update: if canUseSystem();
      allow delete: if isAdmin();
    }

    match /produtos/{documentId} {
      allow read: if canUseSystem();
      allow create, update: if canUseSystem();
      allow delete: if isAdmin();
    }

    match /servicos/{documentId} {
      allow read: if canUseSystem();
      allow create, update: if canUseSystem();
      allow delete: if isAdmin();
    }

    match /movimentacoesEstoque/{documentId} {
      allow read: if canUseSystem();
      allow create: if canUseSystem();
      allow update, delete: if isAdmin();
    }

    match /ordensServico/{osId} {
      allow read: if canUseSystem();
      allow create, update: if canUseSystem();
      allow delete: if isAdmin();

      match /{document=**} {
        allow read: if canUseSystem();
        allow create, update: if canUseSystem();
        allow delete: if isAdmin();
      }
    }

    match /vendas/{vendaId} {
      allow read: if canUseSystem();
      allow create, update: if canUseSystem();
      allow delete: if isAdmin();

      match /{document=**} {
        allow read: if canUseSystem();
        allow create, update: if canUseSystem();
        allow delete: if isAdmin();
      }
    }

    match /movimentacoesCaixa/{documentId} {
      allow read: if canUseSystem();
      allow create: if canUseSystem();
      allow update, delete: if isAdmin();
    }

    match /fechamentosCaixa/{documentId} {
      allow read, create: if canUseSystem();
      allow update, delete: if isAdmin();
    }

    match /registrosFinanceiros/{documentId} {
      allow read: if canUseSystem();
      allow create: if canUseSystem();
      allow update: if canUseSystem();
      allow delete: if isAdmin();
    }

    match /contasReceber/{documentId} {
      allow read: if canUseSystem();
      allow create: if canUseSystem();
      allow update: if canUseSystem();
      allow delete: if isAdmin();
    }

    match /recebimentos/{documentId} {
      allow read: if canUseSystem();
      allow create: if canUseSystem();
      allow update, delete: if isAdmin();
    }

    match /contasPagar/{documentId} {
      allow read: if canUseSystem();
      allow create, update: if canUseSystem();
      allow delete: if isAdmin();
    }

    match /pagamentos/{documentId} {
      allow read: if canUseSystem();
      allow create: if canUseSystem();
      allow update, delete: if isAdmin();
    }

    match /fornecedores/{documentId} {
      allow read: if canUseSystem();
      allow create, update: if canUseSystem();
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if isMaster();
    }
  }
}
